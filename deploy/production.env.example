# Production environment of CityKart Drishti (P2-6 review round 1, I-1 / I-2). A template: never put real values in this file.
#
# Give each process its OWN env file (outside the repository, readable by its service account only; Windows:
#   made and locked by node scripts/gen-secrets.mjs --production --out-dir <folder>, and kept locked by deploy\windows\drishti-services.ps1
#   -Action RepairAcl; never a bare icacls /grant:r, which keeps other people's entries: docs/drishti/runbooks/secret-rotation.md
# ), with only the lines of its section below. The full service key (SUPABASE_SERVICE_ROLE_KEY) belongs to the web app alone (GoTrue's
# user administration); in production the worker and the gateway refuse to start when it is in their environment.
# Generate the values with `node scripts/gen-secrets.mjs --file <file> --jwt-secret-env <NAME>` (prints names only, never a value;
# never overwrites a value without --rotate). Rotation and restarts: docs/drishti/runbooks/secret-rotation.md.
# P5.4 (Windows services): `node scripts/gen-secrets.mjs --production --out-dir C:\Drishti\config --jwt-secret-env <NAME>` writes the
# four files of the services at once (web.env, worker.env, gateway.env, go2rtc.env; outside the repository only, never over an
# existing file), with the web app on 127.0.0.1:3212 (PORT, HOSTNAME) and the gateway on 127.0.0.1:3412 behind Caddy.
# docs/drishti/runbooks/windows-services.md. In production every secret below must be 32+ characters, not a guessable pattern, and
# different from every other one (the start-up check refuses otherwise).
#
# DRISHTI_ENV=production is the one switch (lib/runtime-mode.ts, scripts/lib/runtime-mode.mjs). With it every process checks itself
# at start-up and refuses, with one plain line and exit code 1, when something below is missing (lib/startup-checks.ts).

# ── Every process ──────────────────────────────────────────────────────────────
DRISHTI_ENV=production
NODE_ENV=production
TZ=Asia/Kolkata
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=

# ── Web app (npm run build && npm run start) ────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_APP_WEB_KEY=
SUPABASE_MEDIA_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_STREAM_GATEWAY_URL=
# The server reads the gateway's /g/health on this computer, never through the TLS proxy (which does not pass /g/health on): needed
# whenever NEXT_PUBLIC_STREAM_GATEWAY_URL is an explicit wss:// or https:// address (P5.4 fix round 5).
GATEWAY_HEALTH_URL=http://127.0.0.1:3412
STREAM_TOKEN_SECRET=
ACCESS_PREVIEW_SECRET=
MERGE_CONFIRM_SECRET=
VERIFIED_USER_SECRET=
CRON_SECRET=
SYSTEM_LOG_INGEST_SECRET=
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_API_USERNAME=
GO2RTC_API_PASSWORD=
# Behind one reverse proxy: 1 (the sign-in delays are then per e-mail address AND client IP, with a per-IP ceiling).
TRUSTED_PROXY_HOPS=1
# Normally empty. Never a loopback or other special address (refused at start-up).
OUTBOUND_TARGET_ALLOWLIST=
# Must stay empty in production (the generated test picture is development only).
DEMO_VIDEO=

# ── Worker (npm run worker) ─────────────────────────────────────────────────────
# Its own key only; NOT the service key.
SUPABASE_MONITOR_WORKER_KEY=
WORKER_SECRET=

# ── Gateway (npm run gateway) ───────────────────────────────────────────────────
# Its own key only; NOT the service key. It also checks at start-up that go2rtc refuses a request without the login.
SUPABASE_VIDEO_GATEWAY_KEY=
STREAM_TOKEN_SECRET=
GATEWAY_PORT=3412
# On this computer only, behind the TLS proxy (runbook-tls.md).
GATEWAY_HOST=127.0.0.1
# Behind the TLS proxy every video socket comes from 127.0.0.1: believe the one hop Caddy adds (the per-address limits, P5.5).
TRUSTED_PROXY_HOPS=1
GATEWAY_ALLOWED_ORIGINS=
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_API_USERNAME=
GO2RTC_API_PASSWORD=

# ── go2rtc (docker compose; the same two login values as above) ────────────────
# Start it with the check first, as npm run stack:up does with .env.local:
#   node scripts/check-go2rtc-env.mjs --compose-env <file> && docker compose --env-file <file> -f deploy/docker-compose.dev.yml up -d
# In production the check refuses without GO2RTC_API_USERNAME / GO2RTC_API_PASSWORD (32+ characters).

# ── GoTrue (the hosted Supabase project's Auth settings, not this file) ─────────
# GoTrue sees every sign-in as coming from the web server's address (the sign-in is a server-side call), so its per-IP limits are one
# counter for the whole installation. Raise the "sign-ins and sign-ups" rate limit (local stack: supabase/config.toml
# [auth.rate_limit] sign_in_sign_ups) to at least 1000 per 5 minutes; the app's own sign-in gate (per e-mail address + IP, atomic, in
# the database) is the brute-force limit. A 429 from GoTrue is answered "Sign-in is busy, please try again in a moment" and is not
# counted as a wrong password.
