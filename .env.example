# Copy the generated values with: npm run env:local   (writes .env.local, never committed)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_APP_URL=http://localhost:3212
NEXT_PUBLIC_STREAM_GATEWAY_URL=http://localhost:3412
TZ=Asia/Kolkata
CRON_SECRET=
WORKER_SECRET=
STREAM_TOKEN_SECRET=
SYSTEM_LOG_INGEST_SECRET=

# Monitoring worker (seconds; defaults shown)
DEVICE_CHECK_SEC=60
CAMERA_CHECK_SEC=300
FAIL_THRESHOLD=2
# How many stores are checked at the same time (1 to 50)
STORE_CONCURRENCY=10
# How long an NVR is left alone after it refused the saved login (60 to 86400), so a wrong password cannot lock the account
NVR_LOGIN_BACKOFF_SEC=900

# Video gateway (npm run gateway) and go2rtc (npm run stack:up)
# go2rtc stays on this machine; the gateway is the only video address a browser reaches.
GO2RTC_URL=http://127.0.0.1:1984
GATEWAY_PORT=3412
# Web app addresses allowed to open video sockets, comma separated, no paths (default: NEXT_PUBLIC_APP_URL). The Live page runs at the web app address
# (NEXT_PUBLIC_APP_URL) and reaches this gateway at NEXT_PUBLIC_STREAM_GATEWAY_URL, so the web app address must be listed here exactly as a browser spells it.
GATEWAY_ALLOWED_ORIGINS=http://localhost:3212

# Development only: set to 1 and stores whose NVR address is this computer (the demo stores) show a generated test picture instead of a camera. Ignored in production.
DEMO_VIDEO=

# Fast playback (2x, 4x, 8x) is optional and needs ffmpeg on the web server. Leave empty to use `ffmpeg` found on PATH (full-path entries only), or give the FULL path of the program (one line, not a bare name).
FFMPEG=

# Secret that signs the access-change preview token (generated, 64 hex characters; keep it private)
ACCESS_PREVIEW_SECRET=
