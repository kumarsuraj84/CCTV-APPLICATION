# Copy the generated values with: npm run env:local   (writes .env.local, never committed)
# P2-6: `node scripts/gen-secrets.mjs` (npm run secrets:gen) adds every missing secret and service key below to an existing .env.local
# without printing any value and without replacing one that is set (--rotate replaces; docs/drishti/runbooks/secret-rotation.md).
# Development or production (P2-6 review round 1, I-1): every process (web app, worker, gateway, npm run stack:up) reads this one
# switch. Production: DRISHTI_ENV=production (deploy/production.env.example); any value other than "development", and NODE_ENV=production,
# mean production too. In production every process refuses to start without its own key, with the full service key in the worker's or
# gateway's environment, without go2rtc's login, or with a loopback address in OUTBOUND_TARGET_ALLOWLIST (lib/startup-checks.ts).
DRISHTI_ENV=development
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The full service key: scripts, seeding, tests and GoTrue's admin API (user administration, web app only). No running service needs it
# for the database once the four keys below are set (in development a missing key falls back to it with a warning; production refuses,
# and in production it must not be in the worker's or the gateway's environment at all: give each process its own env file).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=http://127.0.0.1:55321

# Per-service database keys (P2-6, D-14; JWTs whose role claim names the database role; docs/drishti/adr-service-roles.md)
# web app (npm run dev / start): its own role, no NVR login read
SUPABASE_APP_WEB_KEY=
# the video path of the web app: camera routes, media sessions, NVR logins for video, discovery and the connection test
SUPABASE_MEDIA_SERVICE_KEY=
# the worker (npm run worker)
SUPABASE_MONITOR_WORKER_KEY=
# the gateway (npm run gateway): media_session_open / _still_valid / _close only
SUPABASE_VIDEO_GATEWAY_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3212
NEXT_PUBLIC_STREAM_GATEWAY_URL=http://localhost:3412
TZ=Asia/Kolkata
CRON_SECRET=
WORKER_SECRET=
STREAM_TOKEN_SECRET=
SYSTEM_LOG_INGEST_SECRET=

# Monitoring worker (seconds; defaults shown)
DEVICE_CHECK_SEC=60
CAMERA_CHECK_SEC=300
FAIL_THRESHOLD=2
# How many NVRs (recorders) are checked at the same time (1 to 50). The old name STORE_CONCURRENCY is still accepted.
RECORDER_CONCURRENCY=10
# How long an NVR is left alone after it refused the saved login (60 to 86400), so a wrong password cannot lock the account
NVR_LOGIN_BACKOFF_SEC=900
# "Find cameras for all locations" (admin screen): how many NVRs are asked at the same time (1 to 8)
DISCOVER_ALL_CONCURRENCY=4

# Video gateway (npm run gateway) and go2rtc (npm run stack:up)
# go2rtc stays on this machine; the gateway is the only video address a browser reaches.
GO2RTC_URL=http://127.0.0.1:1984
# go2rtc's API login (P2-6, D-13): the web app and the gateway send it; deploy/go2rtc.yaml reads the same two (npm run stack:up passes them
# from .env.local). The password: 32+ characters (the generator makes 43). Development: both empty = no login, with a warning.
# Production (review round 1, I-2): required — npm run stack:up, the web app and the gateway refuse to start without them, and the gateway
# also refuses when go2rtc answers without asking for the login (a container started before the login was set: npm run stack:up again).
GO2RTC_API_USERNAME=
GO2RTC_API_PASSWORD=
GATEWAY_PORT=3412
# Web app addresses allowed to open video sockets, comma separated, no paths (default: NEXT_PUBLIC_APP_URL). The Live page runs at the web app address
# (NEXT_PUBLIC_APP_URL) and reaches this gateway at NEXT_PUBLIC_STREAM_GATEWAY_URL, so the web app address must be listed here exactly as a browser spells it.
GATEWAY_ALLOWED_ORIGINS=http://localhost:3212

# Development only: set to 1 and stores whose NVR address is this computer (the demo stores) show a generated test picture instead of a camera. Ignored in production.
DEMO_VIDEO=

# Fast playback (2x, 4x, 8x) is optional and needs ffmpeg on the web server. Leave empty to use `ffmpeg` found on PATH (full-path entries only), or give the FULL path of the program (one line, not a bare name).
FFMPEG=

# Secret that signs the access-change preview token (generated; keep it private; shared by every app instance)
ACCESS_PREVIEW_SECRET=

# P2-6 secrets (generated, 32+ characters each, all different; docs/drishti/runbooks/secret-rotation.md)
# the camera-merge confirmation (shared by every app instance; required in production)
MERGE_CONFIRM_SECRET=
# the proxy's verified-user header (it was signed with the service key before P2-6; required in production)
VERIFIED_USER_SECRET=
# for later packages: command signing (D-9), agent check-ins, audit checkpoints (D-15)
SIGNER_SECRET=
AGENT_INGEST_SECRET=
AUDIT_CHECKPOINT_SECRET=

# Outbound target restriction (P2-6, SO-4): extra host:port pairs that may be reached besides the NVRs and devices of the database
# (comma separated; normally empty).
OUTBOUND_TARGET_ALLOWLIST=
# Number of trusted reverse proxies in front of the app (1 for one). Only then is the client IP read from X-Forwarded-For, for the
# sign-in delays keyed by e-mail address and IP (D-11) and the ceiling of 100 sign-in tries per client IP in 15 minutes (review round 1).
# Empty or 0: no proxy is trusted, the delays are per e-mail address, and there is no per-IP ceiling (it would be shared by everybody).
TRUSTED_PROXY_HOPS=
