# Copy the generated values with: npm run env:local   (writes .env.local, never committed)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_APP_URL=http://localhost:3212
NEXT_PUBLIC_STREAM_GATEWAY_URL=http://localhost:3213
TZ=Asia/Kolkata
CRON_SECRET=
WORKER_SECRET=
STREAM_TOKEN_SECRET=
SYSTEM_LOG_INGEST_SECRET=

# Monitoring worker (seconds; defaults shown)
DEVICE_CHECK_SEC=60
CAMERA_CHECK_SEC=300
FAIL_THRESHOLD=2
# How many stores are checked at the same time (1 to 50)
STORE_CONCURRENCY=10
# How long an NVR is left alone after it refused the saved login (60 to 86400), so a wrong password cannot lock the account
NVR_LOGIN_BACKOFF_SEC=900
